# copy to .env (never commit .env)
PORT=3000
PLATFORM_PORT=4010
PLATFORM_URL=http://localhost:4010
DB_PATH=./data/studio.sqlite
MEDIA_DIR=./data/media
# 32 bytes as 64 hex chars; generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=
# shared with the platform for signing delivery webhooks
WEBHOOK_SECRET=
# OAuth client credentials issued by the (fake) platform
OAUTH_CLIENT_ID=studio-client
OAUTH_CLIENT_SECRET=
ENABLE_ADMIN=1
WORKER_POLL_MS=500
